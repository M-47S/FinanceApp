# ==============================================================================
# Dockerfile для GUI-приложения FinanceApp (PyQt6).
# Сборка:  docker build -t fin_gui:dev .
# Запуск:  docker run -d -p 5900:5900 fin_gui:dev
#
# Доступ к GUI — через любой VNC-клиент (TightVNC, RealVNC Viewer и т.п.)
# на <host>:5900
# ==============================================================================

ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim

LABEL maintainer="M-47S"
LABEL description="FinanceApp GUI (PyQt6) with VNC access"

# --- Переменные окружения ---
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

ENV DISPLAY=:99 \
    SCREEN_WIDTH=1280 \
    SCREEN_HEIGHT=800 \
    SCREEN_DEPTH=24 \
    VNC_PORT=5900

# --- Системные зависимости ---
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        fluxbox \
        x11-utils \
        libgl1 \
        libglib2.0-0 \
        libegl1 \
        libdbus-1-3 \
        libxkbcommon-x11-0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-xinerama0 \
        libxcb-cursor0 \
        libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

# --- Рабочая директория ---
WORKDIR /app

# --- Python-зависимости ---
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# --- Код приложения ---
COPY . ./APP/

# --- Директория для результатов «Аналитики» ---
RUN mkdir -p /app/storage

# --- Entrypoint ---
COPY entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# --- Порт VNC ---
EXPOSE ${VNC_PORT}

# --- Точка входа ---
ENTRYPOINT ["/entrypoint.sh"]